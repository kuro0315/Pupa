{
  "name": "pupa",
  "version": "0.2.0",
  "description": "Local-first clipboard card fan.",
  "author": "kuro0315",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tauri dev",
    "tauri": "tauri",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:bridge && npm run test:core",
    "test:core": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:ui": "playwright test",
    "test:native": "node scripts/desktop-smoke.cjs",
    "check": "npm run test && npm run build && npm run test:ui",
    "dist": "tauri build",
    "pack": "tauri build --no-bundle",
    "test:bridge": "node --test tests/tauri-bridge.test.cjs tests/state-order.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "@tauri-apps/cli": "2.12.4"
  },
  "homepage": "https://github.com/kuro0315/Pupa",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuro0315/Pupa.git"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "type": "module"
}
